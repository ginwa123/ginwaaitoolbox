*.webm          binary
*.ogg           binary
*.mp3           binary
*.zip           binary
*.tar           binary
*.gz            binary
*.bz2           binary
*.xz            binary
*.7z            binary
*.pdf           binary
*.so            binary
*.dll           binary
*.dylib         binary
*.exe           binary
*.a             binary
*.o             binary
