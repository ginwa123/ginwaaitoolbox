.{
    .name = .pabrikcore,
    .version = "0.0.0",
    .fingerprint = 0x3c325c50dfa3ce66,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Self-contained sqlite3 / openssl / libpq package (ruangsql).
        // Pinned by URL + hash; exposes a single `databases` module;
        // consumers `@import("databases")` to use it.
        .databases = .{
            // 46d96dd = merge of ginwa123/ruangsql#1, "take the WAL writer
            // slot up front instead of losing writes". busy_timeout 5s ->
            // 15s, a real Config (journal_size_limit / wal_autocheckpoint),
            // `BEGIN IMMEDIATE` in `begin()` so a read-then-write
            // transaction cannot hit an instant, unretryable
            // SQLITE_BUSY_SNAPSHOT, and `database.openWithConfig` so this
            // app can set its own `synchronous`. Before it, a contended
            // write FAILED with "database is locked" and was lost.
            //
            // RE-PINNING: this URL is a COMMIT SHA. A squash-merge of
            // ruangsql invalidates it — the old SHA stays reachable on its
            // branch so the URL keeps resolving, and the build keeps
            // SUCCEEDING against the pre-merge code. Zig also keys the
            // package cache by `.hash`, not by `.url`, so changing the URL
            // alone changes nothing. To move the pin: take the new SHA from
            // `git -C ../ruangsql rev-parse origin/main`, put it here, put
            // a throwaway in `.hash`, run `zig build`, and paste in the
            // `hash mismatch: ... but the fetched package has ...` value it
            // prints. Then `rm -rf zig-pkg && zig build` and confirm the
            // new symbol you rely on actually exists in the extracted
            // package.
            .url = "https://github.com/ginwa123/ruangsql/archive/34277a49cf52d5ab0f32e8bf91d9b493212565e0.tar.gz",
            .hash = "databases-0.0.0-vy-BCKm_BACpq2owAc7vFGF22K9adaubKpZsU6ORghw2",
        },
        // External web-framework library (pure-Zig HTTP server +
        // libcurl-backed HTTP client). Exposes a single `kabelweb` module
        // — consumers `@import("kabelweb")` and reach
        // `kabelweb.server` / `kabelweb.client`.
        //
        // LOCAL DEV OVERRIDE: this is the sibling checkout so the SSE fixes
        // developed in ../kabelweb are exercised here immediately (notably
        // commit 7e97a09 — "keep SSE clients registered after the handler
        // returns + real loop threads", which stops /api/events from
        // delivering a single `connected` frame and then going silent).
        //
        // To restore the released/pinned dependency (CI, other machines),
        // swap this back to:
        //   .url = "git+https://github.com/ginwa123/kabelweb.git#<commit>",
        //   .hash = "kabelweb-0.0.0-<hash>",
        // after pushing the kabelweb commit you want to pin.
        .kabelweb = .{
            .url = "git+https://github.com/ginwa123/kabelweb.git#bb21b2344841494ea2ec52f668ddcf9ed81a754e",
            .hash = "kabelweb-0.0.0-vhZam0jzHADrWo3sAN3dUEnO2xvF0xNZXpAFGT-mcFdH",
        },
        // Cross-platform portable helpers (sleep, fileExists,
        // unixTimestampNanos, etc.) used by every module. Promoted
        // to its own package so multiple sub-packages can `b.dependency`
        // it without each creating a separate `helpers` module that
        // would collide on the file's module ownership.
        .helpers = .{
            .path = "src/helpers",
        },
        // The Zig functional test suite (tests/functional/). A SEPARATE
        // package with an EMPTY dependency list of its own: it boots the
        // `pabrik` binary as a child process and drives it over HTTP, and
        // must never be able to `@import` a `src/` internal - a test that
        // bound to an internal type could pass without crossing the wire,
        // which is the one class of test this suite exists to rule out.
        .functional_tests = .{
            .path = "tests/functional",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        // The functional test package is a path dependency, so it must be
        // inside the package hash.
        "tests",
        // Exclude vendored deps from the package hash — they're
        // hermetic (sqlite3 amalgamation is deterministic) but bloat
        // the cache. Same convention as kabelweb/build.zig.zon.
        // (Doesn't matter much for in-tree path deps, but keeps the
        // hash consistent with future url-based consumers.)
    },
}
