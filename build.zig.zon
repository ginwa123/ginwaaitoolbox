.{
    .name = .nalarcore,
    .version = "0.0.0",
    .fingerprint = 0x288cfd2ff6c19f4c,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Self-contained sqlite3 / openssl / libpq package (ruangsql).
        // Pinned by URL + hash; exposes a single `databases` module;
        // consumers `@import("databases")` to use it.
        .databases = .{
            .url = "https://github.com/ginwa123/ruangsql/archive/2ff5f0968d953ddbe29de3fe950eab167c09dfb7.tar.gz",
            .hash = "databases-0.0.0-vy-BCB5DBAC_foirpjWqNhUG-NLB9YzBtCu5H_gAW1BX",
        },
        // External web-framework library (pure-Zig HTTP server +
        // libcurl-backed HTTP client). Pinned by URL + hash; exposes a
        // single `kabelweb` module — consumers `@import("kabelweb")`
        // and reach `kabelweb.server` / `kabelweb.client`.
        .kabelweb = .{
            .url = "https://github.com/ginwa123/kabelweb/archive/519f42b0e654af4e58b1c13c8fa1a55e74bf5aef.tar.gz",
            .hash = "kabelweb-0.0.0-vhZam9nLGADq96sxxBxtio-9Da_vjlwWh_wvpxcfMoP-",
        },
        // Cross-platform portable helpers (sleep, fileExists,
        // unixTimestampNanos, etc.) used by every module. Promoted
        // to its own package so multiple sub-packages can `b.dependency`
        // it without each creating a separate `helpers` module that
        // would collide on the file's module ownership.
        .helpers = .{
            .path = "src/helpers",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        // Exclude vendored deps from the package hash — they're
        // hermetic (sqlite3 amalgamation is deterministic) but bloat
        // the cache. Same convention as kabelweb/build.zig.zon.
        // (Doesn't matter much for in-tree path deps, but keeps the
        // hash consistent with future url-based consumers.)
    },
}
