.{
    .name = .nalarcore,
    .version = "0.0.0",
    .fingerprint = 0x288cfd2ff6c19f4c,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Self-contained sqlite3 / openssl / libpq package. The package
        // lives in-tree at src/modules/databases/ and exposes a single
        // `databases` module; consumers `@import("databases")` to use it.
        .databases = .{
            .path = "src/modules/databases",
        },
        // Unified web-framework library (pure-Zig HTTP server +
        // libcurl-backed HTTP client). Lives in-tree at
        // src/modules/kabelweb/ and exposes a single `kabelweb` module;
        // consumers `@import("kabelweb")` and reach
        // `kabelweb.server` / `kabelweb.client`. The package's own
        // build.zig wires the vendored prebuilt archive from
        // vendor/curl/<target>/lib/libcurl.a plus system ssl/crypto
        // for the server-side TLS.
        .kabelweb = .{
            .path = "src/modules/kabelweb",
        },
        // Cross-platform portable helpers (sleep, fileExists,
        // unixTimestampNanos, etc.) used by every module. Promoted
        // to its own package so multiple sub-packages can `b.dependency`
        // it without each creating a separate `helpers` module that
        // would collide on the file's module ownership.
        .helpers = .{
            .path = "src/helpers",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        // Exclude vendored deps from the package hash — they're
        // hermetic (sqlite3 amalgamation is deterministic) but bloat
        // the cache. Same convention as kabelweb/build.zig.zon.
        // (Doesn't matter much for in-tree path deps, but keeps the
        // hash consistent with future url-based consumers.)
    },
}
