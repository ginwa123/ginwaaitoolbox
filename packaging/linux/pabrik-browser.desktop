[Desktop Entry]
Name=Pabrik Browser
Comment=Pabrik Browser — open agent workspace in default browser tab
Exec=/usr/local/bin/pabrik-desktop --browser
Icon=/usr/share/pixmaps/pabrik.ico
Terminal=false
Type=Application
Categories=Development;
StartupWMClass=pabrik-browser
Keywords=pabrik;browser;tab;agent;ai;workspace;
