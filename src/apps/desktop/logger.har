e are inside the `foreach (var d in details)` loop where `d` is `IncentiveCostDetail`\\n\\nFor incentive costs, they already have:\\n- ShippingModeId\\n- VehicleTypeId\\n- BaseRateId\\n- CurrencyId\\n\\nBut they're not fetching the names. Let me check what data is available and what needs to be added.\\n\\nLooking at similar patterns in the code (like line 343), the approach is:\\n1. Collect all required IDs\\n2. Call gRPC to fetch the reference data\\n3. Join/map the data to populate the names\\n\\n\\n4. For IncentiveCost, I need to add ShippingMode data fetch and map ShippingModeName, add BaseRate data fetch and map BaseRateName for each incentive detail, and add Currency data fetch and map CurrencyName for each incentive detail. I should examine the full IncentiveCost section to understand where to make these additions.\\n</think>\\n\\nLet me see more of the context around the IncentiveCost section to understand what data is available:\",\"timestamp\":\"1776845757596218766\",\n\"is_input\":\"1\",\"is_output\":\"0\",\"tool_name\":\"bash\",\"finish_reason\":\"tool_calls\"},{\"id\":\"1776845737391592876\",\"session_id\":\"session_1776845557\",\"role\":\"tool\",\"content\":\"<stdout>                    .ToDictionary(g => g.Key, g => g);\\n\\n                var resFallbackCosts = new RepeatedField<FallbackCostModel>();\\n\\n                foreach (var fc in fallbackCosts)\\n                {\\n                    var model = new FallbackCostModel\\n                    {\\n                        Id = fc.Id,\\n                        OrderTypeId = fc.OrderTypeId,\\n                        OrderTypeCode = fc.OrderTypeCode ?? string.Empty,\\n                        OrderTypeName = fc.OrderTypeName ?? string.Empty,\\n                        VehicleTypeId = fc.VehicleTypeId,\\n                        VehicleTypeCode = fc.VehicleTypeCode ?? string.Empty,\\n                        VehicleTypeDetailId = fc.VehicleTypeDetailId,\\n                        VehicleTypeDetailName = fc.VehicleTypeDetailName ?? string.Empty,\\n                        ShippingModeId = fc.ShippingModeId.GetValueOrDefault(),\\n                        ShippingModeCode = fc.ShippingModeCode ?? string.Empty,\\n                        IsTrailer = fc.IsTrailer,\\n                        TrailerTypeId = fc.TrailerTypeId ?? 0,\\n                        TrailerTypeName = fc.TrailerTypeName ?? string.Empty\\n                    };\\n\\n                    if (detailLookup.TryGetValue(fc.Id, out var details))\\n                    {\\n                        foreach (var d in details)\\n                        {\\n                            model.CostDetails.Add(new FallbackCostDetailModel\\n                            {\\n                                ChargeCode = d.ChargeCode,\\n                                ChargeCodeName = d.ChargeCodeName ?? string.Empty,\\n                                Amount = (long?)d.Amount ?? 0,\\n                                ChargeTransactionTypeCode = d.ChargeTransactionTypeCode ?? \\\"\\\",\\n                                ChargeTypeName = d.ChargeTypeName ?? \\\"\\\",\\n                                IsBbmFormula = d.IsBbmFormula,\\n                                FuelConsumptionRatio = (double?)d.FuelConsumptionRatio ?? 0,\\n                                UnitPrice = (long?)d.UnitPrice ?? 0,\\n                                Unit = d.Unit ?? string.Empty\\n                            });\\n                        }\\n                    }\\n\\n                    resFallbackCosts.Add(model);\\n                }\\n\\n                response.FallbackCosts.AddRange(resFallbackCosts);\\n\\n\\n                // Incentive Costs\\n                var incentiveCosts = await _incentiveCostRepository.Db().GetByContractNo(request.ContractNo);\\n                var incentiveCostIds = incentiveCosts.Select(x => (int)x.Id).ToArray();\\n                var incentiveCostDetails = await _incentiveCostDetailRepository.Db().GetByIncentiveCostIds(incentiveCostIds);\\n\\n                var incentiveDetailLookup = incentiveCostDetails\\n                    .GroupBy(x => x.IncentiveCostId)\\n                    .ToDictionary(g => g.Key, g => g);\\n\\n                var resIncentiveCosts = new RepeatedField<IncentiveCostModel>();\\n\\n                foreach (var ic in incentiveCosts)\\n                {\\n                    var incentiveModel = new IncentiveCostModel\\n                    {\\n                        ShippingModeId = ic.ShippingModeId.GetValueOrDefault(),\\n                        ShippingModeCode = ic.ShippingModeCode ?? string.Empty,\\n                        ShippingModeName = string.Empty,\\n                        VehicleTypeId = ic.VehicleTypeId,\\n                        VehicleTypeCode = ic.VehicleTypeCode ?? string.Empty,\\n                        VehicleTypeDetailId = ic.VehicleTypeDetailId,\\n                        VehicleTypeDetailName = ic.VehicleTypeDetailName ?? string.Empty,\\n                        IsTrailer = ic.IsTrailer,\\n                        TrailerTypeId = ic.TrailerTypeId ?? 0,\\n                        TrailerTypeName = ic.TrailerTypeName ?? string.Empty,\\n                        EquipmentId = ic.EquipmentId ?? 0,\\n                        EquipmentName = ic.EquipmentName ?? string.Empty,\\n                    };\\n\\n                    if (incentiveDetailLookup.TryGetValue(ic.Id, out var details))\\n                    {\\n                        foreach (var d in details)\\n                        {\\n                            incentiveModel.ListChargeCode.Add(new IncentiveChargeCodeModel\\n                            {\\n                                ChargeCodeId = d.ChargeCodeId,\\n                                ChargeCode = d.ChargeCode ?? string.Empty,\\n                                ChargeCodeName = d.ChargeCodeName ?? string.Empty,\\n                                Amount = (double?)d.Amount ?? 0,\\n                                BaseRateId = d.BaseRateId ?? 0,\\n                                BaseRateName = string.Empty,\\n                                CurrencyId = d.CurrencyId ?? 0,\\n                                CurrencyCode = d.CurrencyCode ?? string.Empty,\\n                                CurrencyName = string.Empty,\\n                                ChargeTransactionTypeId = d.ChargeTransactionTypeId ?? 0,\\n                                ChargeTransactionTypeCode = d.ChargeTransactionTypeCode ?? string.Empty,\\n                                ChargeTransactionTypeName = d.ChargeTransactionTypeName ?? string.Empty,\\n                                RefChargeCodeId = d.RefChargeCodeId ?? 0,\\n                                RefChargeCodeCode = d.RefChargeCode ?? string.Empty,\\n                                RefChargeCodeName = d.RefChargeCodeName ?? string.Empty,\\n                                ChargeTypeId = d.ChargeTypeId ?? 0,\\n                                ChargeTypeName = d.ChargeTypeName ?? string.Empty,\\n                            });\\n                        }\\n                    }\\n                    resIncentiveCosts.Add(incentiveModel);\\n                }\\n\\n                response.IncentiveCosts.AddRange(resIncentiveCosts);\\n\\n\\n                return response;\\n            }\\n</stdout>\\n<stderr>No errors.</stderr>\\n<exit_code>0</exit_code>\\n<truncated>false</truncated>\\n<timeout>false</timeout>\\n<stdout_lines>111</stdout_lines>\\n<stderr_lines>0</stderr_lines>\\n<is_self>false</is_self>\",\"timestamp\":\"1776845737391595762\",\n\"is_input\":\"0\",\"is_output\":\"1\",\"tool_name\":\"bash\",\"finish_reason\":\"tool\"},{\"id\":\"1776845737371582733\",\"session_id\":\"session_1776845557\",\"role\":\"assistant\",\"content\":\"<think>I see! The pattern is:\\n- Line 297: `ShippingModeName = smj?.Name ?? string.Empty,` - This uses `smj?.Name` from `shippingModeData` join\\n- Line 343: `BaseRateName = crd.BaseRateName,` - This directly uses `crd.BaseRateName`\\n- Line 345: `CurrencyName = curj?.Name,` - This uses `curj?.Name` from `currencyData` join\\n\\nFor the incentive costs section (lines 625, 648, 651), the data is being built from `incentiveCosts` and `incentiveDetailLookup`, but the names are being set to `string.Empty`.\\n\\nI need to check if there are similar lookups needed for ShippingMode, BaseRate, and Currency in the incentive costs section. Let me see the context around lines 625-660 more carefully and understand what data is available.\\n</think>\",\"timestamp\":\"1776845737371589035\",\n\"is_input\":\"1\",\"is_output\":\"0\",\"tool_name\":\"bash\",\"finish_reason\":\"tool_calls\"},{\"id\":\"1776845723564581902\",\"session_id\":\"session_1776845557\",\"role\":\"tool\",\"content\":\"<stdout>                    //join route\\n                    var joinedRoute = from cr in cCustomerRouting\\n                                      join st in shippingTypeData on cr.ShippingTypeId equals st.Id into stJoin\\n                                      from stj in stJoin.DefaultIfEmpty()\\n                                      join r in routeData on cr.RouteId.ToString() equals r.Id into rJoin\\n                                      from rj in rJoin.DefaultIfEmpty()\\n                                      select new RoutingModel\\n                                      {\\n                                          ContractCustomerRoutingId = cr.Id,\\n                                          RoutingName = cr.RoutingName ?? string.Empty,\\n                                          ChargeServiceTypeId = cr.ChargeServiceTypeId,\\n                                          ChargeServiceTypeName = cr?.ChargeServiceTypeName ?? string.Empty,\\n                                          ShippingTypeId = cr.ShippingTypeId,\\n                                          ShippingTypeName = stj?.Name ?? string.Empty,\\n                                          RouteId = cr.RouteId,\\n                                          RouteName = rj?.Name ?? string.Empty,\\n                                          ShippingTypeCode = cr.ShippingTypeCode ?? string.Empty\\n                                      };\\n\\n                    response.ListRouting.AddRange(joinedRoute);\\n\\n                    var cCustomerRoutingCost = await _contractCustomerRoutingCostRepo.db().GetByCustomerRoutingIds(routingIds);\\n                    if (cCustomerRoutingCost.Any())\\n                    {\\n                        int[] routingCostIds = cCustomerRoutingCost.Select(r => r.Id).ToArray();\\n                        string vehicleTypeIds = string.Join(',', cCustomerRoutingCost.Select(v => v.VehicleTypeId).ToArray());\\n                        string shippingModeIds = string.Join(',', cCustomerRoutingCost.Select(v => v.ShippingModeId).ToArray());\\n\\n                        var vehicleTypeTask = _referenceGrpcService.GetListVehicleType(new reqVehicleTypeAll { Id = vehicleTypeIds }, userInfo);\\n                        var shippingModeTask = _referenceGrpcService.GetListShippingMode(new ReqGetListShippingMode { Id = shippingModeIds }, userInfo);\\n\\n                        await Task.WhenAll(vehicleTypeTask, shippingModeTask);\\n                        //to do process data\\n\\n                        var shippingModeData = shippingModeTask.Result.ListShippingMode ?? new RepeatedField<ShippingModeData>();\\n\\n                        var routingCostJoined = (from rc in cCustomerRoutingCost\\n                                                 join sm in shippingModeData on rc.ShippingModeId equals sm.Id into smJoin\\n                                                 from smj in smJoin.DefaultIfEmpty()\\n                                                 join r in cCustomerRouting on rc.ContractCustomerRoutingId equals r.Id\\n                                                 select new CostModel\\n                                                 {\\n                                                     ContractCustomerRoutingCostId = rc.Id,\\n                                                     ContractCustomerRoutingId = rc.ContractCustomerRoutingId,\\n                                                     RoutingName = r.RoutingName ?? string.Empty,\\n                                                     ShippingModeId = rc.ShippingModeId,\\n                                                     ShippingModeCode = rc.ShippingModeCode,\\n                                                     ShippingModeName = smj?.Name ?? string.Empty,\\n                                                     VehicleTypeId = rc.VehicleTypeId,\\n                                                     VehicleTypeCode = rc?.VehicleTypeCode ?? string.Empty,\\n                                                     ChargeServiceTypeId = r.ChargeServiceTypeId,\\n                                                     ChargeServiceTypeName = rc?.ChargeServiceTypeName,\\n                                                     RouteId = r.RouteId,\\n                                                     RouteName = routeData.Where(x => x.Id == r.RouteId.ToString()).FirstOrDefault()?.Name ?? string.Empty,\\n                                                     IsTrailer = rc.IsTrailer,\\n                                                     VehicleTypeDetailId = rc.VehicleTypeDetailId,\\n                                                     VehicleTypeDetailName = rc.VehicleTypeDetailName ?? string.Empty,\\n                                                     EquipmentId = rc.EquipmentId,\\n                                                     EquipmentName = rc.EquipmentName ?? string.Empty,\\n                                                     TrailerTypeId = rc.TrailerTypeId,\\n                                                     TrailerTypeName = rc.TrailerTypeName ?? string.Empty,\\n                                                 }).ToList();\\n\\n                        List<CostModel> costModels = new List<CostModel>();\\n                        var cCustomerRoutingCostDetail = await _contractCustomerRoutingCostDetailRepo.db().GetByRoutingCostDetailIds(routingCostIds);\\n                        if (cCustomerRoutingCostDetail.Any())\\n                        {\\n                            string chargeCodeIds = string.Join(',', cCustomerRoutingCostDetail.Select(r => r.ChargeCodeId));\\n                            string baseRateIds = string.Join(',', cCustomerRoutingCostDetail.Select(r => r.BaseRateId));\\n                            string currencyIds = string.Join(',', cCustomerRoutingCostDetail.Select(r => r.CurrencyId));\\n\\n                            var chargeCodeTask = _referenceGrpcService.GetListChargeCode(new reqChargeCodePagination { Id = chargeCodeIds, ChargeType = \\\"2\\\" }, userInfo);\\n                            var baseRateTask = _referenceGrpcService.GetListBaseRate(new reqBaseRateList { Id = baseRateIds }, userInfo);\\n                            var currencyTask = _referenceGrpcService.GetListCurrency(new reqCurrencyPagination { Id = currencyIds }, userInfo);\\n\\n                            await Task.WhenAll(chargeCodeTask, baseRateTask, currencyTask);\\n\\n                            var baseRateData = baseRateTask.Result.ListBaseRate ?? new RepeatedField<resBaseRateList>();\\n                            var currencyData = currencyTask.Result.ListCurrency ?? new RepeatedField<CurrencyModel>();\\n\\n                            var joinedChargeCode = (from crd in cCustomerRoutingCostDetail\\n                                                    join br in baseRateData on crd.BaseRateId equals br.Id into brJoin\\n                                                    from brj in brJoin.DefaultIfEmpty()\\n                                                    join cur in currencyData on crd.CurrencyId equals cur.Id into curJoin\\n                                                    from curj in curJoin.DefaultIfEmpty()\\n                                                    select new\\n                                                    {\\n                                                        ContractCustomerRoutingCostId = crd.ContractCustomerRoutingCostId,\\n                                                        ContractCustomerRoutingCostDetailId = crd.Id,\\n                                                        ChargeCodeId = crd.ChargeCodeId,\\n                                                        ChargeCode = crd?.ChargeCode,\\n                                                        ChargeCodeName = crd?.ChargeCodeName,\\n                                                        BaseRateId = crd.BaseRateId,\\n                                                        BaseRateName = crd.BaseRateName,\\n                                                        CurrencyId = crd.CurrencyId,\\n                                                        CurrencyName = curj?.Name,\\n                                                        Amount = (double)crd.Amount,\\n                                                        CurrencyCode = crd?.CurrencyCode,\\n                                                        ChargeTransactionTypeId = crd?.ChargeTransactionTypeId,\\n                                                        ChargeTransactionTypeCode = crd?.ChargeTransactionTypeCode,\\n                                                        ChargeTransactionTypeName = crd?.ChargeTransactionTypeName,\\n</stdout>\\n<stderr>No errors.</stderr>\\n<exit_code>0</exit_code>\\n<truncated>false</truncated>\\n<timeout>false</timeout>\\n<stdout_lines>101</stdout_lines>\\n<stderr_lines>0</stderr_lines>\\n<is_self>false</is_self>\",\"timestamp\":\"1776845723564584707\",\n\"is_input\":\"0\",\"is_output\":\"1\",\"tool_name\":\"bash\",\"finish_reason\":\"tool\"},{\"id\":\"1776845723541503967\",\"session_id\":\"session_1776845557\",\"role\":\"assistant\",\"content\":\"<think>I can see the context now. At lines 625, 648, and 651, there are empty strings for ShippingModeName, BaseRateName, and CurrencyName that need to be filled with actual values.\\n\\nLooking at the pattern from other places in the file (e.g., line 297 `ShippingModeName = smj?.Name ?? string.Empty`), I need to find what data these values should be populated from.\\n\\nLet me look at more context to understand what data is available and how to populate these fields. I should look at the full structure and understand what data sources are available.\\n\\nLet me read more of the file to understand the data flow and find where these values should come from.\\n</think>\",\"timestamp\":\"1776845723541510229\",\n\"is_input\":\"1\",\"is_output\":\"0\",\"tool_name\":\"bash\",\"finish_reason\":\"tool_calls\"},{\"id\":\"1776845714045050115\",\"session_id\":\"session_1776845557\",\"role\":\"tool\",\"content\":\"<stdout>                    .ToDictionary(g => g.Key, g => g);\\n\\n                var resIncentiveCosts = new RepeatedField<IncentiveCostModel>();\\n\\n                foreach (var ic in incentiveCosts)\\n                {\\n                    var incentiveModel = new IncentiveCostModel\\n                    {\\n                        ShippingModeId = ic.ShippingModeId.GetValueOrDefault(),\\n                        ShippingModeCode = ic.ShippingModeCode ?? string.Empty,\\n                        ShippingModeName = string.Empty,\\n                        VehicleTypeId = ic.VehicleTypeId,\\n                        VehicleTypeCode = ic.VehicleTypeCode ?? string.Empty,\\n                        VehicleTypeDetailId = ic.VehicleTypeDetailId,\\n                        VehicleTypeDetailName = ic.VehicleTypeDetailName ?? string.Empty,\\n                        IsTrailer = ic.IsTrailer,\\n                        TrailerTypeId = ic.TrailerTypeId ?? 0,\\n                        TrailerTypeName = ic.TrailerTypeName ?? string.Empty,\\n                        EquipmentId = ic.EquipmentId ?? 0,\\n                        EquipmentName = ic.EquipmentName ?? string.Empty,\\n                    };\\n\\n                    if (incentiveDetailLookup.TryGetValue(ic.Id, out var details))\\n                    {\\n                        foreach (var d in details)\\n                        {\\n                            incentiveModel.ListChargeCode.Add(new IncentiveChargeCodeModel\\n                            {\\n                                ChargeCodeId = d.ChargeCodeId,\\n                                ChargeCode = d.ChargeCode ?? string.Empty,\\n                                ChargeCodeName = d.ChargeCodeName ?? string.Empty,\\n                                Amount = (double?)d.Amount ?? 0,\\n                                BaseRateId = d.BaseRateId ?? 0,\\n                                BaseRateName = string.Empty,\\n                                CurrencyId = d.CurrencyId ?? 0,\\n                                CurrencyCode = d.CurrencyCode ?? string.Empty,\\n                                CurrencyName = string.Empty,\\n                                ChargeTransactionTypeId = d.ChargeTransactionTypeId ?? 0,\\n                                ChargeTransactionTypeCode = d.ChargeTransactionTypeCode ?? string.Empty,\\n                                ChargeTransactionTypeName = d.ChargeTransactionTypeName ?? string.Empty,\\n                                RefChargeCodeId = d.RefChargeCodeId ?? 0,\\n                                RefChargeCodeCode = d.RefChargeCode ?? string.Empty,\\n                                RefChargeCodeName = d.RefChargeCodeName ?? string.Empty,\\n                                ChargeTypeId = d.ChargeTypeId ?? 0,\\n                                ChargeTypeName = d.ChargeTypeName ?? string.Empty,\\n                            });\\n                        }\\n                    }\\n                    resIncentiveCosts.Add(incentiveModel);\\n                }\\n\\n</stdout>\\n<stderr>No errors.</stderr>\\n<exit_code>0</exit_code>\\n<truncated>false</truncated>\\n<timeout>false</timeout>\\n<stdout_lines>51</stdout_lines>\\n<stderr_lines>0</stderr_lines>\\n<is_self>false</is_self>\",\"timestamp\":\"1776845714045052619\",\n\"is_input\":\"0\",\"is_output\":\"1\",\"tool_name\":\"bash\",\"finish_reason\":\"tool\"},{\"id\":\"1776845714020342309\",\"session_id\":\"session_1776845557\",\"role\":\"assistant\",\"content\":\"<think>I found the lines with ShippingModeName, BaseRateName, and CurrencyName. Let me read the context around those lines to understand what values should be filled in. Let me see lines around 625, 648, and 651.\\n</think>\",\"timestamp\":\"1776845714020350685\",\n\"is_input\":\"1\",\"is_output\":\"0\",\"tool_name\":\"bash\",\"finish_reason\":\"tool_calls\"},{\"id\":\"1776845708409772157\",\"session_id\":\"session_1776845557\",\"role\":\"tool\",\"content\":\"<stdout>297:                                                     ShippingModeName = smj?.Name ?? string.Empty,\\n343:                                                        BaseRateName = crd.BaseRateName,\\n345:                                                        CurrencyName = curj?.Name,\\n369:                                                             rc.ShippingModeName,\\n392:                                                             ShippingModeName = costGroup.Key.ShippingModeName,\\n415:                                                                     BaseRateName = c.BaseRateName ?? string.Empty,\\n417:                                                                     CurrencyName = c.CurrencyName ?? string.Empty,\\n440:                                    ShippingModeName = cost.ShippingModeName ?? string.Empty,\\n543:                            BaseRateName = item.BaseRateName ?? string.Empty,\\n625:                        ShippingModeName = string.Empty,\\n648:                                BaseRateName = string.Empty,\\n651:                                CurrencyName = string.Empty,\\n</stdout>\\n<stderr>No errors.</stderr>\\n<exit_code>0</exit_code>\\n<truncated>false</truncated>\\n<timeout>false</timeout>\\n<stdout_lines>12</stdout_lines>\\n<stderr_lines>0</stderr_lines>\\n<is_self>false</is_self>\",\"timestamp\":\"1776845708409773981\",\n\"is_input\":\"0\",\"is_output\":\"1\",\"tool_name\":\"bash\",\"finish_reason\":\"tool\"},{\"id\":\"1776845708383599850\",\"session_id\":\"session_1776845557\",\"role\":\"assistant\",\"content\":\"<think>I found the file. Let me search for ShippingModeName, BaseRateName, and CurrencyName in this file to see the context where they are defined.\\n</think>\",\"timestamp\":\"1776845708383611382\",\n\"is_input\":\"1\",\"is_output\":\"0\",\"tool_name\":\"bash\",\"finish_reason\":\"tool_calls\"},{\"id\":\"1776845701885659596\",\"session_id\":\"session_1776845557\",\"role\":\"tool\",\"content\":\"<stdout>using ContractCustomer.Protos;\\nusing ContractCustomer.Repositories;\\nusing ContractCustomer.Repositories.Grpc;\\nusing ContractCustomer.Utils;\\nusing Google.Protobuf.Collections;\\nusing Grpc.Core;\\nusing Microsoft.AspNetCore.Routing;\\nusing Microsoft.IdentityModel.Tokens;\\nusing ReferenceService.Protos;\\n\\nnamespace ContractCustomer.UseCases\\n{\\n    public interface IGetDetailContractCustomerUseCase\\n    {\\n        Task<ResGetDetailContractCustomer> GetDetailContractCustomer(ReqGetDetailContractCustomer request, ServerCallContext context);\\n    }\\n\\n    public class GetDetailContractCustomerUseCase : IGetDetailContractCustomerUseCase\\n    {\\n        private readonly IReferenceGrpcService _referenceGrpcService;\\n        private readonly IContractCustomerRepository _contractCustomerRepo;\\n        private readonly IContractCustomerDetailRepository _contractCustomerDetailRepo;\\n        private readonly IContractCustomerVehicleRepository _contractCustomerVehicleRepo;\\n        private readonly IContractCustomerRoutingRepository _contractCustomerRoutingRepo;\\n        private readonly IContractCustomerRoutingCostRepository _contractCustomerRoutingCostRepo;\\n        private readonly IContractCustomerRoutingCostDetailRepository _contractCustomerRoutingCostDetailRepo;\\n        private readonly IContractModelRepository _contractModelRepo;\\n        private readonly IChangeTypeRepository _changeTypeRepo;\\n        private readonly IContractCustomerRoutingDocumentRepository _contractCustomerRoutingDocumentRepository;\\n        private readonly IMstContractCustomerFallbackCostingRepository _contractCustomerFallbackCostRepository;\\n        private readonly IMstContractCustomerFallbackCostDetailRepository _contractCustomerFallbackCostDetailRepository;\\n        private readonly IMstContractCustomerIncentiveCostRepository _incentiveCostRepository;\\n        private readonly IMstContractCustomerIncentiveCostDetailRepository _incentiveCostDetailRepository;\\n\\n        public GetDetailContractCustomerUseCase(\\n            IReferenceGrpcService referenceGrpcService,\\n            IContractCustomerRepository contractCustomerRepository,\\n            IContractCustomerDetailRepository contractCustomerDetailRepository,\\n            IContractCustomerVehicleRepository contractCustomerVehicleRepository,\\n            IContractCustomerRoutingRepository contractCustomerRoutingRepository,\\n            IContractCustomerRoutingCostRepository contractCustomerRoutingCostRepository,\\n            IContractCustomerRoutingCostDetailRepository contractCustomerRoutingCostDetailRepository,\\n            IContractModelRepository contractModelRepository,\\n            IChangeTypeRepository changeTypeRepository,\\n            IContractCustomerRoutingDocumentRepository contractCustomerRoutingDocumentRepository,\\n            IMstContractCustomerFallbackCostingRepository contractCustomerFallbackCostingRepository,\\n            IMstContractCustomerFallbackCostDetailRepository contractCustomerFallbackCostDetailRepository,\\n            IMstContractCustomerIncentiveCostRepository incentiveCostRepository,\\n            IMstContractCustomerIncentiveCostDetailRepository incentiveCostDetailRepository\\n        )\\n        {\\n            _referenceGrpcService = referenceGrpcService ?? throw new ArgumentNullException(nameof(referenceGrpcService));\\n            _contractCustomerRepo = contractCustomerRepository ?? throw new ArgumentNullException(nameof(contractCustomerRepository));\\n            _contractCustomerDetailRepo = contractCustomerDetailRepository ?? throw new ArgumentNullException(nameof(contractCustomerDetailRepository));\\n            _contractCustomerVehicleRepo = contractCustomerVehicleRepository ?? throw new ArgumentNullException(nameof(contractCustomerVehicleRepository));\\n            _contractCustomerRoutingRepo = contractCustomerRoutingRepository ?? throw new ArgumentNullException(nameof(contractCustomerRoutingRepository));\\n            _contractCustomerRoutingCostRepo = contractCustomerRoutingCostRepository ?? throw new ArgumentNullException(nameof(contractCustomerRoutingCostRepository));\\n            _contractCustomerRoutingCostDetailRepo = contractCustomerRoutingCostDetailRepository ?? throw new ArgumentNullException(nameof(contractCustomerRoutingCostDetailRepository));\\n            _contractModelRepo = contractModelRepository ?? throw new ArgumentNullException(nameof(contractModelRepository));\\n            _changeTypeRepo = changeTypeRepository ?? throw new ArgumentNullException(nameof(changeTypeRepository));\\n            _contractCustomerRoutingDocumentRepository = contractCustomerRoutingDocumentRepository ?? throw new ArgumentNullException(nameof(contractCustomerRoutingDocumentRepository));\\n            _contractCustomerFallbackCostRepository = contractCustomerFallbackCostingRepository ?? throw new ArgumentNullException(nameof(contractCustomerFallbackCostingRepository));\\n            _contractCustomerFallbackCostDetailRepository = contractCustomerFallbackCostDetailRepository ?? throw new ArgumentNullException(nameof(contractCustomerFallbackCostDetailRepository));\\n            _incentiveCostRepository = incentiveCostRepository ?? throw new ArgumentNullException(nameof(incentiveCostRepository));\\n            _incentiveCostDetailRepository = incentiveCostDetailRepository ?? throw new ArgumentNullException(nameof(incentiveCostDetailRepository));\\n        }\\n\\n        public async Task<ResGetDetailContractCustomer> GetDetailContractCustomer(ReqGetDetailContractCustomer request, ServerCallContext context)\\n        {\\n            try\\n            {\\n                var dt = DateTime.UtcNow.AddHours(7);\\n                var userInfo = Helper.GetUserInfo(context);\\n                if (string.IsNullOrWhiteSpace(userInfo.ClientId))\\n                    throw new RpcException(new Grpc.Core.Status(StatusCode.NotFound, \\\"User tidak memiliki client id\\\"));\\n\\n                if (request.ContractNo.IsNullOrEmpty())\\n                    throw new RpcException(new Status(StatusCode.InvalidArgument, \\\"Invalid contract_no\\\"));\\n\\n                var cCustomerData = await _contractCustomerRepo.db().GetByContractNo(request.ContractNo);\\n                if (cCustomerData == null)\\n                    throw new RpcException(new Status(StatusCode.NotFound, \\\"Data contract customer tidak ditemukan, coba lagi!\\\"));\\n\\n                ResGetDetailContractCustomer response = new ResGetDetailContractCustomer();\\n                var contractModel = await _contractModelRepo.db().GetById(cCustomerData.ContractModelId);\\n                var changeTypeData = await _changeTypeRepo.db().GetById(cCustomerData.ChangeTypeId);\\n                var customerList = await _referenceGrpcService.GetListCustomer(new ReqPagingCustomer { Code = cCustomerData.CustomerCode }, userInfo);\\n\\n                //header\\n                var customer = customerList.ListCustomer.FirstOrDefault();\\n\\n                response.Id = cCustomerData.Id;\\n                response.ContractNo = cCustomerData.ContractNo ?? string.Empty;\\n                response.CustomerCode = cCustomerData.CustomerCode ?? string.Empty;\\n                response.CustomerName = cCustomerData.CustomerName ?? string.Empty;\\n                response.StartDate = cCustomerData.StartDate?.ToString(\\\"yyyy-MM-dd\\\") ?? string.Empty;\\n                response.EndDate = cCustomerData.EndDate?.ToString(\\\"yyyy-MM-dd\\\") ?? string.Empty;\\n                response.BillingPlanType = cCustomerData.BillingPlanType ?? string.Empty;\\n                response.ReferenceDocument = cCustomerData.ReferenceDocument ?? string.Empty;\\n                response.ContractModelId = cCustomerData.ContractModelId;\\n                response.ContractModelName = contractModel != null ? contractModel.Name : \\\"\\\";\\n                response.Pool = cCustomerData.PoolId ?? string.Empty;\\n                response.UpdatedAt = cCustomerData.UpdatedAt?.ToString(\\\"o\\\") ?? string.Empty;\\n                response.IsComplete = cCustomerData.IsComplete;\\n                response.CustomerAddress = customer?.Address ?? string.Empty;\\n                response.ContractTypeId = cCustomerData?.ContractTypeId;\\n                response.ContractTypeCode = cCustomerData?.ContractTypeCode ?? string.Empty;\\n                response.ContractTypeName = cCustomerData?.ContractTypeName ?? string.Empty;\\n                response.Status = dt >= cCustomerData?.StartDate && dt <= cCustomerData?.EndDate ? \\\"Aktif\\\" : dt > cCustomerData?.EndDate ? \\\"Selesai\\\" : dt < cCustomerData?.StartDate ? \\\"Nonaktif\\\" : string.Empty;\\n                response.CustomerPicName = cCustomerData?.CustomerPicName ?? string.Empty;\\n                response.CustomerPicHp = cCustomerData?.CustomerPicHp ?? string.Empty;\\n                response.CustomerCodeOrderer = cCustomerData?.CustomerCodeOrderer ?? string.Empty;\\n                response.CustomerNameOrderer = cCustomerData?.CustomerNameOrderer ?? string.Empty;\\n                response.CreditLimit = customer != null ? Convert.ToInt64(customer.CreditLimit) : 0;\\n                response.TermOfPayment = customer?.TermOfPayment == 0 || customer?.TermOfPayment == null ? string.Empty : customer?.TermOfPayment.ToString() + \\\" hari\\\" ?? string.Empty;\\n                response.Npwp = customer?.Npwp ?? string.Empty;\\n                response.CustomerBillingAddress = cCustomerData?.CustomerBillingAddress ?? string.Empty;\\n                response.QuotationNo = cCustomerData?.QuotationNo ?? string.Empty;\\n                response.QuotationDate = cCustomerData?.QuotationDate != null ? cCustomerData.QuotationDate.Value.ToString(\\\"yyyy-MM-dd\\\") : string.Empty;\\n                response.QuotationFileUrl = cCustomerData?.QuotationFileUrl ?? string.Empty;\\n                response.SalesOrganization = customer?.SalesOrganization ?? string.Empty;\\n                response.DistributionChannel = customer?.DistributionChannel ?? string.Empty;\\n                response.Division = customer?.Division ?? string.Empty;\\n                response.SalesGroup = customer?.SalesGroup ?? string.Empty;\\n                response.SalesOffice = customer?.SalesOffice ?? string.Empty;\\n                response.ShipToPartyCode = cCustomerData?.ShipToPartyCode ?? string.Empty;\\n                response.ShipToPartyName = cCustomerData?.ShipToPartyName ?? string.Empty;\\n                response.PicName = cCustomerData?.PicName ?? string.Empty;\\n                response.PicAddress = cCustomerData?.PicAddress ?? string.Empty;\\n                response.Priority = cCustomerData?.Priority ?? string.Empty;\\n                response.Industry = cCustomerData?.Industry ?? string.Empty;\\n                response.ServiceComplexity = cCustomerData?.ServiceComplexity ?? string.Empty;\\n\\n                var cCustomerDetailData = await _contractCustomerDetailRepo.db().GetByContractNo(cCustomerData?.ContractNo ?? \\\"\\\");\\n                var cCustomerRouting = await _contractCustomerRoutingRepo.db().GetByContractNo(cCustomerData?.ContractNo ?? \\\"\\\");\\n\\n                if (cCustomerDetailData.Any())\\n                {\\n                    int[] cCustomerDataIds = cCustomerDetailData.Select(c => c.Id).ToArray();\\n                    var cCustomerVehicleData = await _contractCustomerVehicleRepo.db().GetByContractCustomerDetailIds(cCustomerDataIds);\\n                    string vehicleTypeIds = cCustomerVehicleData.Any() ? string.Join(',', cCustomerVehicleData.Select(v => v.VehicleTypeId).ToArray()) : string.Empty;\\n                    string vehicleTypeDetailsIds = cCustomerVehicleData.Any() ? string.Join(',', cCustomerVehicleData.Select(v => v.VehicleTypeDetailId).ToArray()) : string.Empty;\\n                    var vehicleTypeTask = _referenceGrpcService.GetListVehicleType(new reqVehicleTypeAll { Id = vehicleTypeIds }, userInfo);\\n                    var vehicleTypeDetailTask = _referenceGrpcService.GetListVehicleTypeDetails(new ReqGetListVehicleTypeDetail { Id = vehicleTypeDetailsIds }, userInfo);\\n\\n                    await Task.WhenAll(vehicleTypeTask, vehicleTypeDetailTask);\\n                    var vehicleTypeData = vehicleTypeTask.Result?.ListVehicleType ?? new RepeatedField<resVehicleTypeData>();\\n                    var vehicleTypeDetailData = vehicleTypeDetailTask.Result?.ListVehicleType ?? new RepeatedField<ResGetListVehicleTypeDetailData>();\\n\\n                    var listVehicleJoined = (from v in cCustomerVehicleData\\n                                             join vt in vehicleTypeData on v.VehicleTypeId equals vt.Id into vtJoin\\n                                             from vtj in vtJoin.DefaultIfEmpty()\\n                                             join vtd in vehicleTypeDetailData on v.VehicleTypeDetailId equals vtd.Id into vtdJoin\\n                                             from vtdj in vtdJoin.DefaultIfEmpty()\\n                                             select new\\n                                             {\\n                                                 ContractCustomerDetailId = v.ContractCustomerDetailId,\\n                                                 ContractCustomerVehicleId = v.Id,\\n                                                 DetailNo = v.DetailNo,\\n                                                 VehicleTypeId = v.VehicleTypeId,\\n                                                 VehicleTypeCode = v?.VehicleTypeCode ?? string.Empty,\\n                                                 VehicleTypeDetailId = v.VehicleTypeDetailId,\\n                                                 VehicleTypeDetailName = v?.VehicleTypeDetailName ?? string.Empty,\\n                                                 FleetNumber = v.FleetNumber ?? string.Empty,\\n                                                 LicenseNumber = v.LicenseNumber ?? string.Empty,\\n                                                 EquipmentNumber = v.EquipmentNumber ?? string.Empty,\\n                                                 MaxTimeOperation = v.MaxTimeOperation,\\n                                                 VehicleClassId = v.VehicleClassId,\\n                                                 VehicleClassCode = v?.VehicleClassCode ?? string.Empty,\\n                                                 TotalRevenue = v?.TotalRevenue != null ? v?.TotalRevenue : 0,\\n                                                 Tax = v?.Tax != null ? v?.Tax : 0,\\n                                             }).ToList();\\n\\n                    var detailJoined = (from d in cCustomerDetailData\\n                                        join v in (listVehicleJoined ?? Enumerable.Empty<dynamic>())\\n                                            on d.Id equals v.ContractCustomerDetailId into dvGroup\\n                                        from joined in dvGroup.DefaultIfEmpty()\\n                                        group joined by new\\n                                        {\\n                                            d.Id,\\n                            