    {
      "code": "deep_link_not_in_manifest",
      "detail": "`navDeepLink` declares nalar://chats/{workspaceId}, but AndroidManifest.xml has no <data android:scheme=\"nalar\" android:host=\"chats\">. `adb shell am start -a android.intent.action.VIEW -d nalar://chats/{workspaceId}` resolves to no activity, and it does so silently.",
      "severity": "error",
      "site": {
        "file": "src/apps/android_mobile/app/src/main/java/com/nalar/mobile/network/NalarNavGraph.kt",
