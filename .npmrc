# Workspace-wide pnpm settings (2026-08-28 — pnpm migration).
#
# node-linker=hoisted: produce a flat node_modules layout (deps installed
# directly under node_modules/, no .pnpm/ symlink indirection) that
# matches what npm would have produced. Required because some of our
# tooling (e.g. vite's plugin resolution) walks sibling node_modules
# paths that pnpm's default isolated layout would not expose. Same
# trade-off as the prior npm-based setup, so this is a no-op for the
# rest of the build chain — `node_modules/.bin/vite` lives at the same
# path either way.
node-linker=hoisted

# engine-strict=false: do NOT fail when a pnpm install sees a
# `engines: { node: "^20.19.0 || >=22.12.0" }` constraint that the
# developer's node doesn't quite satisfy. The webapp's
# package.json pins an engines range; CI uses Node 24 which is well
# above the floor, but local devs may sit on Node 22.18.x and we don't
# want a hostile abort on every install.
engine-strict=false

# Postinstall allowlist moved to pnpm-workspace.yaml in pnpm 11.
# `onlyBuiltDependencies=esbuild` is ignored (the legacy field path is
# the package.json#pnpm.onlyBuiltDependencies, which pnpm 11 also
# removed). mcp_hello_world has a pnpm-workspace.yaml that approves
# esbuild's postinstall (vitest's transitive dep); the webapp has no
# postinstall scripts to approve so it gets no pnpm-workspace.yaml.
