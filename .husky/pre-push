#!/usr/bin/env sh
# Pre-push hook — mirror CI's `backend` + frontend build gates exactly
# so pushes can't slip past locally with failures CI would catch.
#
# CI runs the same steps via .github/workflows/ci.yml:
#   - "Backend"  (line 935):  zig build test nalar-desktop --summary all
#   - "Functional tests"   (line 1229): zig build functional-test --summary all
#   - "UI tests"           (line 1331): zig build functional-test-ui --summary all
#   - Frontend build: pnpm run build in src/apps/desktop (vite + vue-tsc)
# We run the commands without `--summary all` for terser local
# output (full log is not the point here — the exit code is).
#
# Husky runs this script from the worktree root (per core.hooksPath),
# which is the repo root that contains build.zig — so no `cd` needed
# for the zig step. `zig build` resolves paths from CWD and build.zig
# sits at the repo root, so a bare `zig build test` works. The frontend
# build needs CWD=src/apps/desktop (vite + vue-tsc resolve relative to
# package.json), so it runs in a subshell to avoid disturbing the root.
#
# Bypass for emergencies: `git push --no-verify`.

set -e

echo "→ zig build test"
zig build test

echo "→ pnpm run build (src/apps/desktop)"
(cd src/apps/desktop && pnpm run build)

echo "✓ pre-push: all gates passed"
