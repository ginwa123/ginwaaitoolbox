#!/usr/bin/env sh
# Pre-commit hook — mirror CI's `lint (oxlint + eslint)` job exactly so
# commits can't slip past locally with lint errors that CI would catch.
#
# Mirrors the "Lint (oxlint + eslint, fail-on-issue mode)" step in the
# `lint` job of `.github/workflows/ci.yml`:
#   working-directory: src/apps/desktop
#   run: pnpm run lint:check
#
# That step used to live at ci.yml lines 1485-1491 and the CI job was
# deleted in PR #398 ("drop frontend job"), which left this hook
# mirroring nothing. It is back as a gate as of the pipeline
# restructure, so the mirror is real again.
#
# The `cd src/apps/desktop` here matches that working-directory because
# pnpm lint scripts resolve relative to CWD. Husky runs this script from
# the worktree root (per core.hooksPath), so we MUST cd first.
#
# Bypass for emergencies: `git commit --no-verify`.

cd src/apps/desktop || exit 1
pnpm run lint:check
