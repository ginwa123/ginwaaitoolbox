#!/usr/bin/env sh
# Pre-commit hook — mirror CI's `Lint (oxlint + eslint, fail-on-issue mode)`
# step exactly so commits can't slip past locally with lint errors that
# CI would catch.
#
# Mirrors `.github/workflows/ci.yml` lines 1485-1491:
#   working-directory: src/apps/desktop
#   run: pnpm run lint:check
#
# The `cd src/apps/desktop` here matches that working-directory because
# pnpm lint scripts resolve relative to CWD. Husky runs this script from
# the worktree root (per core.hooksPath), so we MUST cd first.
#
# Bypass for emergencies: `git commit --no-verify`.

cd src/apps/desktop || exit 1
pnpm run lint:check
